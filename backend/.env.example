# KidArt Gallery Backend - Environment Variables
# Copy to .env and fill in values

# REQUIRED: JWT signing secret (generate a random string)
SECRET_KEY=your-random-secret-key-here

# Database (SQLite default, or PostgreSQL URL)
DATABASE_URL=sqlite:///./kidart_gallery.db

# Anthropic API Key (for Claude AI agents)
ANTHROPIC_API_KEY=sk-ant-...

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:8180

# File upload directory
UPLOAD_DIR=uploads

# Upload size limit (MB)
UPLOAD_MAX_SIZE_MB=10

# JWT token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VLM server URL (for story generation)
VLM_URL=http://localhost:8100/v1/chat/completions
